# 逆ジオコーディングの設定（いずれも任意）
# GOOGLE_MAPS_API_KEY を設定すると Google Geocoding API を使います。
# 未設定の場合は APIキー不要の Nominatim（OpenStreetMap）を使います。
GOOGLE_MAPS_API_KEY=

# Nominatim の利用ポリシーにより、アプリを識別できる User-Agent が必要です（連絡先を入れることを推奨）
NOMINATIM_USER_AGENT=spot-explorer/1.0

# Nominatim の接続先（任意）。自前の Nominatim を使う場合に変更します。未設定なら公開インスタンスを使います。
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# DB の接続情報（任意）。未設定なら postgres / postgres / spots を使います。
# パスワードは DB のボリューム作成時（初回起動時）に反映されます。
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=spots
